configuration {
  modi: "drun,run,window";
  show-icons: true;
  font: "Iosevka Nerd Font 13";
  display-drun: " ";
  display-window: " ";
}

* {
  bg: rgba(8, 8, 8, 0.88);
  bg-alt: rgba(255, 255, 255, 0.08);
  fg: #ffffff;
  border-col: rgba(255, 255, 255, 0.18);
  background-color: transparent;
  text-color: @fg;
}

window {
  width: 560px;
  background-color: @bg;
  border: 1px;
  border-color: @border-col;
  border-radius: 12px;
}

mainbox {
  padding: 16px;
  spacing: 12px;
}

inputbar {
  background-color: @bg-alt;
  border-radius: 8px;
  padding: 10px 14px;
  spacing: 8px;
  children: [prompt, entry];
}

prompt {
  text-color: #ffffff;
}

entry {
  placeholder: "search...";
  placeholder-color: #666666;
  text-color: #ffffff;
}

listview {
  lines: 8;
  spacing: 4px;
  scrollbar: false;
}

element {
  padding: 8px 12px;
  border-radius: 8px;
  spacing: 10px;
}

element selected.normal {
  background-color: #ffffff;
  text-color: #000000;
}

element-icon {
  size: 26px;
}
